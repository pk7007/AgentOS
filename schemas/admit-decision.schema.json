{
  "$id": "agentos/admit-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowed": {
      "title": "Allowed",
      "type": "boolean"
    },
    "depth": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth"
    },
    "instance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instance Id"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    }
  },
  "required": [
    "allowed",
    "reasons"
  ],
  "title": "AdmitDecision",
  "type": "object"
}
